# 複製為 .env 並填入；systemd 也可改用 EnvironmentFile=/opt/discord-agent/.env
# 權限請設為 600：chmod 600 .env

# 必要：Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

# 管理面板登入密碼（若留空，程式會在首次啟動時產生一組並印在日誌）
PANEL_PASSWORD=

# LLM API 金鑰（依你在面板啟用的供應商填寫）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 選用：工具呼叫的網頁搜尋（Tavily）
TAVILY_API_KEY=

# 選用：VPS 指令工具（也可直接在面板貼入）
VPS_SSH_KEY=

# 選用：多媒體
# GROQ_API_KEY=
